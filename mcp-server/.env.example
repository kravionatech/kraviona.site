KRAVIONA_API_URL=http://localhost:4000
KRAVIONA_ADMIN_EMAIL=admin@example.com
KRAVIONA_ADMIN_PASSWORD=replace-with-the-admin-password

# Required only for remote Streamable HTTP + persistent multi-Claude OAuth.
MONGO_URI=mongodb://127.0.0.1:27017/kraviona-site
DB_NAME=kraviona-site
MCP_BEARER_TOKEN=replace-with-at-least-24-random-characters
MCP_PUBLIC_URL=http://localhost:4100
MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
MCP_OAUTH_ACCESS_TOKEN_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_DAYS=30
MCP_DB_TIMEOUT_MS=10000
PORT=4100
